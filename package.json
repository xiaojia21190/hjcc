{
  "name": "huijin-etf-monitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "audit": "bun run scripts/data-audit.ts",
    "calibrate": "bun run scripts/calibrate-mainline.ts",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "fetch": "bun run scripts/fetch-data.ts",
    "server": "bun run server/index.ts",
    "dev:server": "bun run server/index.ts",
    "dev:vite": "vite",
    "dev": "concurrently -n fetch,server,vite -c red,blue,green \"bun run fetch\" \"bun run dev:server\" \"bun run dev:vite\"",
    "start": "bun run dev"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
